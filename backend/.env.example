# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars!
JWT_EXPIRES_IN=1d

# Database Configuration (MySQL + Prisma)
